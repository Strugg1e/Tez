{
  "version": "0.1.0",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "Tez desktop network client",
    "icon": [
      "tez-icons/32x32.png",
      "tez-icons/128x128.png",
      "tez-icons/128x128@2x.png",
      "tez-icons/icon.icns",
      "tez-icons/icon.ico"
    ],
    "resources": [
      "resources"
    ],
    "publisher": "Tez",
    "externalBin": [
      "sidecar/verge-mihomo",
      "sidecar/verge-mihomo-alpha"
    ],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "Tez",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "Tez",
  "identifier": "app.tez.client",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tez"
        ]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": [
        "desktop-capability",
        "migrated"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}
